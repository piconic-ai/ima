{
  "name": "@piconic/ima",
  "version": "0.0.1",
  "description": "Co-edit a local Markdown file with others, right now. End-to-end encrypted.",
  "keywords": [
    "markdown",
    "collaboration",
    "crdt",
    "yjs",
    "cli"
  ],
  "license": "MIT",
  "homepage": "https://github.com/piconic-ai/ima#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piconic-ai/ima.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/piconic-ai/ima/issues",
  "type": "module",
  "bin": {
    "ima": "dist/ima.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepack": "cp ../../README.md ../../LICENSE ."
  },
  "devDependencies": {
    "@ima/protocol": "workspace:^",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "fast-diff": "^1.3.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  }
}
